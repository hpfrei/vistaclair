{
  "name": "vistaclair",
  "version": "1.5.0",
  "description": "Remote control room, agent inspector, and multi-provider model router for Claude Code",
  "author": "Hans-Peter Frei (https://hpfreilabs.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hpfrei/vistaclair.git"
  },
  "homepage": "https://hpfreilabs.com/vistaclair/",
  "bugs": {
    "url": "https://github.com/hpfrei/vistaclair/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "remote-control",
    "remote-agent",
    "agent-inspector",
    "agent-monitoring",
    "observability",
    "model-router",
    "model-override",
    "llm-proxy",
    "ai-gateway",
    "mcp",
    "ai-agent",
    "coding-agent",
    "devtools",
    "web-dashboard",
    "openai",
    "gemini",
    "deepseek"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "server.js",
  "bin": {
    "vistaclair": "bin/vistaclair.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "lib/",
    "docs/",
    "server.js",
    "templates/",
    "mcp-servers/integrated/server.js",
    "mcp-servers/integrated/meta.json",
    "mcp-servers/integrated/package.json",
    "mcp-servers/integrated/tools/",
    "platform/",
    "!platform/test/"
  ],
  "scripts": {
    "postinstall": "node bin/postinstall.js",
    "start": "node bin/supervisor.js",
    "dev": "node bin/supervisor.js dev",
    "test": "node --test \"test/*.test.js\" \"platform/test/*.test.js\"",
    "test:core": "node --test \"test/*.test.js\"",
    "test:platform": "node --test \"platform/test/*.test.js\"",
    "test:fixtures": "node platform/test/gen-fixtures.js",
    "test:e2e:pause": "node test/e2e/pause-resume.e2e.js",
    "check:capabilities": "node platform/src/apps/capabilities-check.js",
    "infer:capabilities": "node platform/src/apps/capabilities-infer.js",
    "lint:app": "node platform/src/apps/app-lint.js",
    "apps:claudemd": "node platform/src/apps/standing-rules.js",
    "access": "node platform/scripts/access.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.299",
    "cron-parser": "^4.9.0",
    "dom-serializer": "^2.0.0",
    "domutils": "^3.2.2",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.1",
    "html-to-text": "^10.0.0",
    "htmlparser2": "^10.1.0",
    "imapflow": "^1.0.0",
    "mailparser": "^3.9.9",
    "mariadb": "^3.5.2",
    "nodemailer": "^8.0.10",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "ffmpeg-static": "^5.3.0",
    "node-pty": "^1.0.0",
    "onnxruntime-node": "^1.24.3",
    "puppeteer": "^25.1.0"
  }
}
