#!/opt/vistaclair-ml/venv/bin/python
"""musicgen — generate music locally with Meta MusicGen (CPU).

Usage:
  musicgen --prompt "energetic corporate electronic, 120bpm, uplifting" \
           --duration 30 --out /path/track.wav [--model small] [--seed 42] \
           [--continue-from /path/prev.wav]

Output: WAV (32kHz mono) at --out, and a JSON status line on stdout:
  {"ok":true,"out":"...","duration":30.0,"model":"facebook/musicgen-small","seed":42}

--continue-from conditions generation on the last 10s of an existing clip so
long beds can be built by windowed continuation (segments overlap-free).
Exit code 0 on success; nonzero + {"ok":false,"error":...} on stdout otherwise.
"""
import argparse, json, os, sys, time

os.environ.setdefault("HF_HOME", "/opt/vistaclair-ml/hf-cache")

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--prompt", required=True)
    p.add_argument("--duration", type=float, default=30.0, help="seconds, max ~30 per pass")
    p.add_argument("--out", required=True)
    p.add_argument("--model", default="small", choices=["small", "medium"])
    p.add_argument("--seed", type=int, default=None)
    p.add_argument("--continue-from", dest="cont", default=None)
    a = p.parse_args()

    t0 = time.time()
    import torch
    import numpy as np
    import soundfile as sf
    from transformers import AutoProcessor, MusicgenForConditionalGeneration

    if a.seed is not None:
        torch.manual_seed(a.seed)

    device = "cuda" if torch.cuda.is_available() else "cpu"
    model_id = f"facebook/musicgen-{a.model}"
    processor = AutoProcessor.from_pretrained(model_id)
    model = MusicgenForConditionalGeneration.from_pretrained(model_id)
    model.to(device)
    model.eval()
    sr = model.config.audio_encoder.sampling_rate  # 32000

    # ~50 audio tokens/sec
    max_new = int(min(a.duration, 30.0) * 50)

    kwargs = dict(text=[a.prompt], padding=True, return_tensors="pt")
    if a.cont:
        prev, prev_sr = sf.read(a.cont, dtype="float32")
        if prev.ndim > 1:
            prev = prev.mean(axis=1)
        if prev_sr != sr:
            import librosa
            prev = librosa.resample(prev, orig_sr=prev_sr, target_sr=sr)
        tail = prev[-10 * sr:]
        kwargs["audio"] = tail
        kwargs["sampling_rate"] = sr

    inputs = processor(**kwargs).to(device)
    with torch.no_grad():
        audio = model.generate(**inputs, do_sample=True, guidance_scale=3.0,
                               max_new_tokens=max_new)
    wav = audio[0, 0].cpu().numpy()
    # If continuation, generated audio includes the conditioning tail — trim it
    if a.cont:
        wav = wav[len(kwargs["audio"]):] if len(wav) > len(kwargs["audio"]) else wav
    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
    sf.write(a.out, wav, sr)
    print(json.dumps({"ok": True, "out": a.out, "duration": round(len(wav) / sr, 2),
                      "model": model_id, "seed": a.seed, "device": device,
                      "elapsed": round(time.time() - t0, 1)}))

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(json.dumps({"ok": False, "error": str(e)}))
        sys.exit(1)
